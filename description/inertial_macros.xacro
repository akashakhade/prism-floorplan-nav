<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Box inertia -->
    <xacro:macro name="inertial_box" params="mass x y z *origin">

        <inertial>
            <mass value="${mass}" />

            <inertia
                ixx="${mass / 12.0 * (y*y + z*z)}"
                ixy="0.0"
                ixz="0.0"
                iyy="${mass / 12.0 * (x*x + z*z)}"
                iyz="0.0"
                izz="${mass / 12.0 * (x*x + y*y)}" />

            <xacro:insert_block name="origin" />
        </inertial>

    </xacro:macro>


    <!-- Cylinder inertia -->
    <xacro:macro name="inertial_cylinder" params="mass length radius *origin">

        <inertial>
            <mass value="${mass}" />

            <inertia
                ixx="${mass / 12.0 * (3*radius*radius + length*length)}"
                ixy="0.0"
                ixz="0.0"
                iyy="${mass / 12.0 * (3*radius*radius + length*length)}"
                iyz="0.0"
                izz="${mass / 2.0 * radius*radius}" />

            <xacro:insert_block name="origin" />
        </inertial>

    </xacro:macro>


    <!-- Sphere inertia -->
    <xacro:macro name="inertial_sphere" params="mass radius *origin">

        <inertial>
            <mass value="${mass}" />

            <inertia
                ixx="${2.0 / 5.0 * mass * radius*radius}"
                ixy="0.0"
                ixz="0.0"
                iyy="${2.0 / 5.0 * mass * radius*radius}"
                iyz="0.0"
                izz="${2.0 / 5.0 * mass * radius*radius}" />

            <xacro:insert_block name="origin" />
        </inertial>

    </xacro:macro>

</robot>
