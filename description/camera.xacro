<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========================= -->
    <!-- Camera physical link -->
    <!-- ========================= -->

    <link name="camera_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.03 0.10 0.03"/>
            </geometry>
            <material name="Orange"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.03 0.10 0.03"/>
            </geometry>
        </collision>

        <xacro:inertial_box mass="0.05" x="0.03" y="0.10" z="0.03">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>

    </link>


    <!-- chassis front face = x 0.20 -> camera mounted just in front -->
    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.215 0 0.10" rpy="0 0 0"/>
    </joint>


    <!-- ROS optical frame: z forward, x right, y down -->
    <link name="camera_optical_link"/>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_optical_link"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>


    <!-- ========================= -->
    <!-- Gazebo Harmonic RGB-D camera -->
    <!-- ========================= -->

    <gazebo reference="camera_link">

        <sensor name="rgbd_camera" type="rgbd_camera">

            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>15</update_rate>
            <topic>camera</topic>
            <gz_frame_id>camera_optical_link</gz_frame_id>

            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.1</near>
                        <far>10.0</far>
                    </clip>
                </depth_camera>
            </camera>

        </sensor>

    </gazebo>

</robot>